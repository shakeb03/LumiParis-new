{%- comment -%}
  Four category tiles. Each tile uses its own image, then the collection image, then an Ivory Soft block.
{%- endcomment -%}
<section class="lumi-section">
  <div class="lumi-section__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="lumi-section__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <ul class="lumi-tiles" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign tile_collection = block.settings.collection
          assign tile_image = block.settings.image | default: tile_collection.featured_image
          assign tile_label = block.settings.label | default: tile_collection.title
        -%}
        <li class="lumi-tiles__item" {{ block.shopify_attributes }}>
          <a class="lumi-tiles__link" href="{{ tile_collection.url | default: routes.all_products_collection_url }}">
            <div class="lumi-tiles__media">
              {%- if tile_image != blank -%}
                {{
                  tile_image
                  | image_url: width: 900
                  | image_tag: widths: '300, 450, 600, 900', sizes: '(min-width: 750px) 25vw, 50vw', loading: 'lazy', alt: ''
                }}
              {%- endif -%}
            </div>
            <span class="lumi-tiles__label">{{ tile_label }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .lumi-tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-16);
  }

  .lumi-tiles__link {
    display: block;
    text-decoration: none;
    color: var(--warm-ink);
  }

  .lumi-tiles__media {
    aspect-ratio: 4 / 5;
    background-color: var(--ivory-soft);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .lumi-tiles__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lumi-tiles__label {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-lumi-heading);
    font-weight: 500;
    font-size: 22px;
  }

  @media screen and (min-width: 750px) {
    .lumi-tiles {
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-24);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lumi category tiles",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Defaults to the collection title."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lumi category tiles",
      "blocks": [{ "type": "tile" }, { "type": "tile" }, { "type": "tile" }, { "type": "tile" }]
    }
  ]
}
{% endschema %}
