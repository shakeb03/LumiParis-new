{%- comment -%}
  Password page until launch: "Lumi Paris is opening soon. Wear the light." with the early access sign-up.
{%- endcomment -%}
<section class="lumi-password">
  <div class="lumi-password__inner">
    {%- if settings.logo != blank -%}
      {{ settings.logo | image_url: width: 480 | image_tag: class: 'lumi-password__logo', alt: shop.name, widths: '240, 480' }}
    {%- else -%}
      <p class="lumi-password__wordmark">{{ shop.name }}</p>
    {%- endif -%}
    <h1 class="lumi-password__heading">{{ section.settings.heading }}</h1>
    <p class="lumi-password__tagline">{{ section.settings.tagline }}</p>

    {%- form 'customer', class: 'lumi-password__form' -%}
      <input type="hidden" name="contact[tags]" value="early-access,newsletter">
      {%- if form.posted_successfully? -%}
        <p role="status">{{ section.settings.success_text }}</p>
      {%- else -%}
        <p class="lumi-label">{{ section.settings.signup_heading }}</p>
        <label class="visually-hidden" for="LumiPasswordEmail">Email</label>
        <div class="lumi-early-access__fields">
          <input
            class="lumi-early-access__input"
            id="LumiPasswordEmail"
            type="email"
            name="contact[email]"
            autocomplete="email"
            placeholder="Email"
            required
          >
          <button class="lumi-button" type="submit">{{ section.settings.button_label }}</button>
        </div>
        {%- if form.errors -%}
          <p role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
        {%- endif -%}
        <p class="lumi-early-access__consent">{{ section.settings.consent_text }}</p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% stylesheet %}
  .lumi-password {
    min-height: 80svh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-40) var(--space-16);
    background-color: var(--lumi-cream);
    text-align: center;
  }

  .lumi-password__inner {
    width: 100%;
    max-width: 30em;
  }

  .lumi-password__logo {
    width: 160px;
    height: auto;
    margin: 0 auto var(--space-40);
    display: block;
  }

  .lumi-password__wordmark {
    font-family: var(--font-lumi-heading);
    font-size: 32px;
    margin: 0 0 var(--space-40);
  }

  .lumi-password__heading {
    font-family: var(--font-lumi-heading);
    font-weight: 500;
    font-size: 40px;
    line-height: 1.05;
    margin: 0 0 8px;
  }

  .lumi-password__tagline {
    margin: 0 0 var(--space-40);
  }

  .lumi-password__form {
    text-align: left;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lumi password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Lumi Paris is opening soon."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Wear the light."
    },
    {
      "type": "text",
      "id": "signup_heading",
      "label": "Sign-up label",
      "default": "Be first to see new pieces."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Join the list"
    },
    {
      "type": "text",
      "id": "consent_text",
      "label": "Consent line",
      "default": "By joining, you agree to receive email from Lumi Paris. Unsubscribe at any time."
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Thank you. You're on the list."
    }
  ],
  "presets": [
    {
      "name": "Lumi password"
    }
  ]
}
{% endschema %}
