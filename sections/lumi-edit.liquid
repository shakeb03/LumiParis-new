{%- comment -%}
  The edit: 4 to 6 products in a swipe row on mobile, a grid on desktop. No autoplay.
{%- endcomment -%}
{%- assign edit_collection = section.settings.collection | default: collections.all -%}
<section class="lumi-section">
  <div class="lumi-section__inner">
    <div class="lumi-edit__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="lumi-section__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <a class="lumi-edit__link" href="{{ edit_collection.url | default: routes.all_products_collection_url }}">
        {{- section.settings.link_label -}}
      </a>
    </div>
    <ul class="lumi-edit__row" role="list">
      {%- for product in edit_collection.products limit: section.settings.max_products -%}
        <li class="lumi-edit__item">
          {%- render 'lumi-product-card', product: product, sizes: '(min-width: 750px) 25vw, 70vw' -%}
        </li>
      {%- else -%}
        <li class="lumi-edit__empty">Pieces arrive here once they are listed.</li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
  .lumi-edit__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-16);
  }

  .lumi-edit__link {
    color: var(--warm-ink);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }

  .lumi-edit__row {
    list-style: none;
    margin: 0 calc(-1 * var(--space-16));
    padding: 0 var(--space-16);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 70%;
    gap: var(--space-16);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .lumi-edit__row::-webkit-scrollbar {
    display: none;
  }

  .lumi-edit__item {
    scroll-snap-align: start;
  }

  @media screen and (min-width: 750px) {
    .lumi-edit__row {
      margin: 0;
      padding: 0;
      grid-auto-flow: row;
      grid-template-columns: repeat(4, 1fr);
      grid-auto-columns: auto;
      overflow: visible;
      gap: var(--space-24);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lumi edit",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The edit"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Defaults to all products."
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Products",
      "min": 4,
      "max": 6,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop all"
    }
  ],
  "presets": [
    {
      "name": "Lumi edit"
    }
  ]
}
{% endschema %}
