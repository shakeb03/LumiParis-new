{%- comment -%}
  About page: the approved story letter (edited in Online Store > Pages > About) set as a letter.
  The page body stays plain paragraphs; this section styles them:
  - the opening "Hello," as the salutation
  - the approved name line as a quiet pull line between champagne hairlines
  - the last two paragraphs ("Wear the light." and "Lumi Paris") as the sign-off
{%- endcomment -%}
{%- liquid
  assign chunks = page.content | split: '</p>'
  assign paragraph_count = 0
  for chunk in chunks
    assign trimmed = chunk | strip
    if trimmed contains '<p'
      assign paragraph_count = paragraph_count | plus: 1
    endif
  endfor
  assign signoff_from = paragraph_count | minus: 1
-%}
<section class="lumi-about">
  {%- if section.settings.image != blank -%}
    <div class="lumi-about__media">
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          widths: '600, 900, 1200, 1600, 2000',
          sizes: '100vw',
          loading: 'eager',
          class: 'lumi-about__image',
          alt: section.settings.image.alt
      }}
    </div>
  {%- endif -%}

  <article class="lumi-about__letter">
    <h1 class="lumi-about__title">{{ section.settings.heading | default: page.title }}</h1>
    <hr class="lumi-about__rule" aria-hidden="true">

    <div class="lumi-about__body">
      {%- assign index = 0 -%}
      {%- for chunk in chunks -%}
        {%- assign trimmed = chunk | strip -%}
        {%- if trimmed contains '<p' -%}
          {%- assign index = index | plus: 1 -%}
          {%- liquid
            assign paragraph_class = ''
            assign plain = trimmed | strip_html | strip
            if index == 1 and plain.size < 20
              assign paragraph_class = 'lumi-about__salutation'
            elsif plain contains 'Lumi comes from lumi'
              assign paragraph_class = 'lumi-about__name-line'
            elsif index == signoff_from
              assign paragraph_class = 'lumi-about__closing'
            elsif index == paragraph_count
              assign paragraph_class = 'lumi-about__signature'
            endif
          -%}
          {%- if paragraph_class != blank -%}
            {%- assign class_attr = '<p class="' | append: paragraph_class | append: '"' -%}
            {{ trimmed | replace_first: '<p', class_attr | append: '</p>' }}
          {%- else -%}
            {{ trimmed | append: '</p>' }}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.link_label != blank -%}
      <a class="lumi-button lumi-button--secondary lumi-about__link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
        {{- section.settings.link_label -}}
      </a>
    {%- endif -%}
  </article>
</section>

{% stylesheet %}
  .lumi-about {
    background-color: var(--lumi-cream);
    padding-bottom: var(--space-64);
  }

  .lumi-about__media {
    aspect-ratio: 3 / 2;
    max-height: 70vh;
    overflow: hidden;
    background-color: var(--ivory-soft);
  }

  .lumi-about__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lumi-about__letter {
    max-width: 36rem;
    margin-inline: auto;
    padding: var(--space-40) var(--space-16) 0;
  }

  .lumi-about__title {
    font-family: var(--font-lumi-heading);
    font-weight: 500;
    font-size: 40px;
    line-height: 1.05;
    margin: 0;
    text-align: center;
  }

  .lumi-about__rule {
    width: 48px;
    border: 0;
    border-top: 1px solid var(--champagne);
    margin: var(--space-24) auto var(--space-40);
  }

  .lumi-about__body p {
    font-size: 17px;
    line-height: 1.75;
    margin: 0 0 1.15em;
  }

  .lumi-about__body .lumi-about__salutation {
    font-family: var(--font-lumi-heading);
    font-size: 26px;
    line-height: 1.3;
    margin-bottom: 0.8em;
  }

  .lumi-about__body .lumi-about__name-line {
    font-family: var(--font-lumi-heading);
    font-size: 26px;
    line-height: 1.3;
    text-align: center;
    margin: var(--space-40) 0;
    padding: var(--space-24) 0;
    border-top: 1px solid var(--champagne);
    border-bottom: 1px solid var(--champagne);
  }

  .lumi-about__body .lumi-about__closing {
    font-family: var(--font-lumi-heading);
    font-size: 28px;
    line-height: 1.2;
    margin: var(--space-40) 0 4px;
  }

  .lumi-about__body .lumi-about__signature {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--stone-text);
    margin: 0;
  }

  .lumi-about__body a {
    color: var(--warm-ink);
    text-underline-offset: 3px;
  }

  .lumi-about__link {
    margin-top: var(--space-40);
  }

  @media screen and (min-width: 750px) {
    .lumi-about__letter {
      margin-top: var(--space-64);
      padding: var(--space-64);
      max-width: 44rem;
      background-color: var(--ivory-soft);
      border-radius: var(--radius);
    }

    .lumi-about__media + .lumi-about__letter {
      position: relative;
      margin-top: calc(-1 * var(--space-64));
    }

    .lumi-about__title {
      font-size: 56px;
    }

    .lumi-about__body p {
      font-size: 18px;
    }

    .lumi-about__body .lumi-about__salutation,
    .lumi-about__body .lumi-about__name-line {
      font-size: 32px;
    }

    .lumi-about__body .lumi-about__closing {
      font-size: 34px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lumi about letter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About Lumi Paris"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Optional. Hands, fabric and light, no faces (Website Imagery brief)."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Shop the edit"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    }
  ],
  "presets": [
    {
      "name": "Lumi about letter"
    }
  ]
}
{% endschema %}
