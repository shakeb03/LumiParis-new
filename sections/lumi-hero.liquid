{%- comment -%}
  Home hero: one soft-light image. Until the AI imagery is approved it shows an Ivory Soft block.
{%- endcomment -%}
<section class="lumi-hero">
  <div class="lumi-hero__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          widths: '600, 900, 1200, 1600, 2000',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          class: 'lumi-hero__image',
          alt: section.settings.image.alt
      }}
    {%- endif -%}
  </div>
  <div class="lumi-hero__content">
    {%- if section.settings.heading != blank -%}
      <h1 class="lumi-hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="lumi-hero__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a class="lumi-button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
        {{- section.settings.button_label -}}
      </a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .lumi-hero {
    display: grid;
    background-color: var(--ivory-soft);
  }

  .lumi-hero__media {
    aspect-ratio: 4 / 5;
    background-color: var(--ivory-soft);
    overflow: hidden;
  }

  .lumi-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lumi-hero__content {
    padding: var(--space-40) var(--space-16);
    background-color: var(--lumi-cream);
  }

  .lumi-hero__heading {
    font-family: var(--font-lumi-heading);
    font-weight: 500;
    font-size: 40px;
    line-height: 1.05;
    margin: 0 0 var(--space-16);
  }

  .lumi-hero__text {
    margin: 0 0 var(--space-24);
    max-width: 32em;
  }

  @media screen and (min-width: 750px) {
    .lumi-hero {
      grid-template-columns: 1fr 1fr;
      align-items: stretch;
    }

    .lumi-hero__media {
      aspect-ratio: auto;
      min-height: 70vh;
    }

    .lumi-hero__content {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: var(--space-64);
    }

    .lumi-hero__heading {
      font-size: 64px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lumi hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to show an Ivory Soft block until AI imagery is approved."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wear the light."
    },
    {
      "type": "text",
      "id": "text",
      "label": "Line",
      "default": "Luminous everyday jewelry, meant to be lived in."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the edit"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Lumi hero"
    }
  ]
}
{% endschema %}
