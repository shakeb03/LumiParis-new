{%- comment -%}
  Three plain facts about materials and care. Written from the real catalog once styles are chosen.
  Facts still holding the [FACT FROM BRANVAS DATA] placeholder only show in the theme editor.
{%- endcomment -%}
{%- liquid
  assign visible_facts = 0
  for block in section.blocks
    unless block.settings.text contains '[FACT FROM'
      assign visible_facts = visible_facts | plus: 1
    endunless
  endfor
-%}
{%- if visible_facts > 0 or request.design_mode -%}
<section class="lumi-section lumi-section--band">
  <div class="lumi-section__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="lumi-section__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <ul class="lumi-facts" role="list">
      {%- for block in section.blocks -%}
        {%- assign is_placeholder = false -%}
        {%- if block.settings.text contains '[FACT FROM' -%}
          {%- assign is_placeholder = true -%}
        {%- endif -%}
        {%- if is_placeholder == false or request.design_mode -%}
          <li class="lumi-facts__item" {{ block.shopify_attributes }}>
            {%- if block.settings.label != blank -%}
              <p class="lumi-label">{{ block.settings.label }}</p>
            {%- endif -%}
            <p class="lumi-facts__text">{{ block.settings.text }}</p>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
  </div>
</section>
{%- endif -%}

{% stylesheet %}
  .lumi-facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-24);
  }

  .lumi-facts__item {
    border-top: 1px solid var(--champagne);
    padding-top: var(--space-16);
  }

  .lumi-facts__text {
    margin: 8px 0 0;
  }

  @media screen and (min-width: 750px) {
    .lumi-facts {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-40);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Lumi facts",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What it is made of"
    }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Fact",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Fact",
          "info": "Only facts confirmed in the supplier data. Placeholders are hidden on the live theme.",
          "default": "[FACT FROM BRANVAS DATA]"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lumi facts",
      "blocks": [{ "type": "fact" }, { "type": "fact" }, { "type": "fact" }]
    }
  ]
}
{% endschema %}
