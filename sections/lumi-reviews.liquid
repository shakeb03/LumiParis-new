{%- comment -%}
  Reviews from real buyers only, through a reviews app block. Hidden until switched on.
{%- endcomment -%}
{%- if section.settings.enabled -%}
  <section class="lumi-section">
    <div class="lumi-section__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="lumi-section__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          {% render block %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Lumi reviews",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show reviews",
      "info": "Switch on only once real buyers have left reviews.",
      "default": false
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "From people who wear it"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Lumi reviews"
    }
  ]
}
{% endschema %}
